generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  ADMIN
  MANAGEMENT
  AREA_LEAD
  EMPLOYEE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketEventType {
  READ
  CREATED
  ASSIGNED
  STATUS_CHANGED
  COMMENTED
  CLOSED
  PRIORITY_CHANGED
  REOPENED
  TRANSFERRED
  LINKED
}

enum CommentVisibility {
  PUBLIC
  INTERNAL
}

enum LinkType {
  PARENT_OF
  RELATED
  DUPLICATE_OF
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  isActive     Boolean    @default(true)
  globalRole   GlobalRole @default(EMPLOYEE)
  /// Incremented on logout, role/password change or deactivation to revoke issued JWTs.
  tokenVersion Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  ledAreas          Area[]            @relation("AreaLead")
  memberships       AreaMembership[]
  requestedTickets  Ticket[]          @relation("TicketRequester")
  assignedTickets   Ticket[]          @relation("TicketAssignee")
  comments          TicketComment[]
  events            TicketEvent[]
  notifications     Notification[]
  createdLinks      TicketLink[]
  quickReplies      QuickReply[]
  attachments       Attachment[]
  watchers          TicketWatcher[]
}

model Area {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  parentId   String?
  parent     Area?    @relation("AreaTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Area[]   @relation("AreaTree")
  leadUserId String?
  lead       User?    @relation("AreaLead", fields: [leadUserId], references: [id], onDelete: SetNull)
  /// Materialized ancestor path built from ids, e.g. "/rootId/hrId/". Used for subtree scoping.
  path       String   @unique
  depth      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships AreaMembership[]
  tickets     Ticket[]
  quickReplies QuickReply[]
  attachments  Attachment[]
}

model AreaMembership {
  id        String   @id @default(cuid())
  userId    String
  areaId    String
  canAssign Boolean  @default(false)
  canClose  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  area      Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([userId, areaId])
}

model Ticket {
  id          String         @id @default(cuid())
  number      String         @unique
  title       String
  body        String
  requesterId String
  areaId      String
  assigneeId  String?
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  category    String?
  dueAt       DateTime?
  waitingUntil DateTime?
  resolvedAt  DateTime?
  closedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  requester     User            @relation("TicketRequester", fields: [requesterId], references: [id])
  area          Area            @relation(fields: [areaId], references: [id])
  assignee      User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  comments      TicketComment[]
  events        TicketEvent[]
  notifications Notification[]
  linksFrom     TicketLink[]    @relation("LinkFrom")
  linksTo       TicketLink[]    @relation("LinkTo")
  attachments   Attachment[]
  watchers      TicketWatcher[]
}

model TicketComment {
  id         String            @id @default(cuid())
  ticketId   String
  authorId   String
  body       String
  visibility CommentVisibility @default(PUBLIC)
  createdAt  DateTime          @default(now())
  ticket     Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User              @relation(fields: [authorId], references: [id])
  attachments Attachment[]
}

model TicketLink {
  id          String   @id @default(cuid())
  fromId      String
  toId        String
  type        LinkType @default(RELATED)
  createdById String
  createdAt   DateTime @default(now())

  fromTicket Ticket @relation("LinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toTicket   Ticket @relation("LinkTo", fields: [toId], references: [id], onDelete: Cascade)
  creator    User   @relation(fields: [createdById], references: [id])

  @@unique([fromId, toId, type])
}

model TicketEvent {
  id         String          @id @default(cuid())
  ticketId   String
  actorId    String
  type       TicketEventType
  message    String
  fromStatus TicketStatus?
  toStatus   TicketStatus?
  /// JSON with structured details (reason, previous values, ...).
  metadata   String?
  createdAt  DateTime        @default(now())
  ticket     Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor      User            @relation(fields: [actorId], references: [id])
}

/// System-wide, append-only audit trail. Rows are hash-chained (prevHash -> hash)
/// and protected by database triggers against UPDATE and DELETE.
model AuditLog {
  id         String   @id @default(cuid())
  seq        Int      @unique
  occurredAt DateTime
  actorId    String?
  actorRole  String?
  actorRank  Int?
  action     String
  result     String
  entityType String
  entityId   String?
  areaId     String?
  areaPath   String?
  before     String?
  after      String?
  reason     String?
  ip         String?
  userAgent  String?
  requestId  String?
  prevHash   String
  hash       String

  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@index([entityType, entityId])
  @@index([areaPath])
  @@index([action])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  ticketId  String?
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket    Ticket?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model TicketWatcher {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
}

model QuickReply {
  id          String   @id @default(cuid())
  areaId      String
  title       String
  body        String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  area    Area @relation(fields: [areaId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [createdById], references: [id])
}

model Attachment {
  id          String   @id @default(cuid())
  ticketId    String
  commentId   String?
  areaId      String
  uploaderId  String
  filename    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  createdAt   DateTime @default(now())

  ticket   Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  comment  TicketComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  area     Area           @relation(fields: [areaId], references: [id], onDelete: Cascade)
  uploader User           @relation(fields: [uploaderId], references: [id])

  @@index([ticketId])
}

model TicketCounter {
  id    Int @id
  value Int @default(0)
}
